{
  "name": "Open Map Surface",
  "short_name": "Map Surface",
  "description": "Draw, measure, import, export and share maps. Leaflet + OpenStreetMap, no API keys, no backend.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eef1ef",
  "theme_color": "#0b6e4f",
  "lang": "en",
  "categories": [
    "productivity",
    "utilities",
    "navigation"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New blank map",
      "short_name": "Blank map",
      "url": "./#blank",
      "description": "Open the map without the saved drawings"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/geo+json": [
          ".geojson"
        ],
        "application/json": [
          ".json"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ]
}
